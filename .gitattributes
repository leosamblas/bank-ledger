# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Java and build files
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.conf text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Binary files
*.jar binary
*.zip binary

