						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/health",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Verifica se o API Gateway (Nginx) está operacional na porta 8080."
					},
					"response": []
				},
				{
					"name": "account-service Actuator Health",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{accountServiceUrl}}/actuator/health",
							"host": [
								"{{accountServiceUrl}}"
							],
							"path": [
								"actuator",
								"health"
							]
						},
						"description": "Health check do account-service na porta 8081."
					},
					"response": []
				},
				{
