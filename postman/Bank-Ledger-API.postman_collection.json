{
	"info": {
		"_postman_id": "b3e9a781-428d-4f88-87c2-9a674e2d9812",
		"name": "Bank Ledger - API Ecosystem",
		"description": "Collection completa para testes pontuais e end-to-end do ecossistema bancário Bank Ledger.\n\nContém endpoints para:\n- **account-service**: Onboarding, cadastro de clientes, autenticação JWT, consulta de conta\n- **transaction-service**: Depósitos e saques com Idempotency-Key e validação assíncrona\n- **ledger-service**: Core contábil interno (saldos de partidas dobradas, diário contábil e balancete atômico)\n- **query-service**: Consultas CQRS de extrato e saldos de leitura\n- **health checks**: Monitoramento via Spring Actuator e Nginx Gateway\n\nTodos os endpoints possuem scripts para autocompletar tokens JWT, IDs gerados e cabeçalhos de idempotência.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "gatewayUrl",
			"value": "http://localhost:8080",
			"type": "string",
			"description": "URL base do API Gateway (Nginx Reverse Proxy)"
		},
		{
			"key": "accountServiceUrl",
			"value": "http://localhost:8081",
			"type": "string",
			"description": "URL direta do account-service"
		},
		{
			"key": "transactionServiceUrl",
			"value": "http://localhost:8082",
			"type": "string",
			"description": "URL direta do transaction-service"
		},
		{
			"key": "queryServiceUrl",
			"value": "http://localhost:8083",
			"type": "string",
			"description": "URL direta do query-service"
		},
		{
			"key": "ledgerServiceUrl",
			"value": "http://localhost:8084",
			"type": "string",
			"description": "URL direta do ledger-service (Core Contábil Interno)"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string",
			"description": "Token JWT Bearer gerado no login (preenchido automaticamente)"
		},
		{
			"key": "accountId",
			"value": "",
			"type": "string",
			"description": "ID UUID da conta bancária (preenchido automaticamente na criação)"
		},
		{
			"key": "customerId",
			"value": "",
			"type": "string",
			"description": "ID UUID do cliente titular"
		},
		{
			"key": "agency",
			"value": "0001",
			"type": "string",
			"description": "Agência bancária"
		},
		{
			"key": "accountNumber",
			"value": "10001",
			"type": "string",
			"description": "Número da conta"
		},
		{
			"key": "checkDigit",
			"value": "9",
			"type": "string",
			"description": "Dígito verificador da conta"
		},
		{
			"key": "customerCpf",
			"value": "12345678901",
			"type": "string",
			"description": "CPF cadastrado para login"
		},
		{
			"key": "customerPassword",
			"value": "SenhaForte@123",
			"type": "string",
			"description": "Senha cadastrada para login"
		},
		{
			"key": "lastTransactionId",
			"value": "",
			"type": "string",
			"description": "ID UUID da última transação financeira gerada"
		}
	],
	"item": [
		{
			"name": "1. Autenticação & Onboarding (account-service)",
			"description": "Endpoints de cadastro de novos correntistas e emissão de tokens JWT.",
			"item": [
				{
					"name": "1.1 Criar Nova Conta (Abertura)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var data = pm.response.json();",
									"    if (data.accountId) {",
									"        pm.collectionVariables.set(\"accountId\", data.accountId);",
									"        console.log(\"[Postman] accountId atualizado:\", data.accountId);",
									"    }",
									"    if (data.customerId) {",
									"        pm.collectionVariables.set(\"customerId\", data.customerId);",
									"        console.log(\"[Postman] customerId atualizado:\", data.customerId);",
									"    }",
									"    if (data.branch) {",
									"        pm.collectionVariables.set(\"agency\", data.branch);",
									"    }",
									"    if (data.accountNumber) {",
									"        pm.collectionVariables.set(\"accountNumber\", data.accountNumber);",
									"    }",
									"    if (data.checkDigit) {",
									"        pm.collectionVariables.set(\"checkDigit\", data.checkDigit);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fullName\": \"João da Silva\",\n    \"cpf\": \"{{customerCpf}}\",\n    \"birthDate\": \"1990-05-15\",\n    \"email\": \"joao.silva@example.com\",\n    \"phone\": \"+5511999998888\",\n    \"password\": \"{{customerPassword}}\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/accounts",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"accounts"
							]
						},
						"description": "Cria um novo cliente e provisiona sua conta corrente bancária. Emite evento AccountOpened no Kafka para o ledger-service."
					},
					"response": []
				},
				{
					"name": "1.2 Login (Gerar Token JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    if (data.token) {",
									"        pm.collectionVariables.set(\"authToken\", data.token);",
									"        console.log(\"[Postman] authToken atualizado com sucesso!\");",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cpf\": \"{{customerCpf}}\",\n    \"password\": \"{{customerPassword}}\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/auth/login",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Realiza login com CPF e senha criptografada (BCrypt). O token retornado é automaticamente injetado na variável `authToken` para todas as requisições autenticadas da coleção."
					},
					"response": []
				},
				{
					"name": "1.3 Consultar Minha Conta (/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/accounts/me",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"accounts",
								"me"
							]
						},
						"description": "Retorna os detalhes da conta do usuário autenticado através das claims do token JWT."
					},
					"response": []
				},
				{
					"name": "1.4 Buscar Conta por Agência e Número (/lookup)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/accounts/lookup?agency={{agency}}&number={{accountNumber}}",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"accounts",
								"lookup"
							],
							"query": [
								{
									"key": "agency",
									"value": "{{agency}}"
								},
								{
									"key": "number",
									"value": "{{accountNumber}}"
								}
							]
						},
						"description": "Busca dados públicos de uma conta bancária (agência, número e nome mascarado do titular) para validação pré-transferência."
					},
					"response": []
				},
				{
					"name": "1.5 Consultar Conta por ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/accounts/{{accountId}}",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"accounts",
								"{{accountId}}"
							]
						},
						"description": "Consulta os detalhes de uma conta específica por ID UUID. Valida autorização do titular ou perfil administrativo."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Operações Financeiras (transaction-service)",
			"description": "Endpoints para realização de depósitos e saques com suporte a Idempotency-Key via cabeçalho HTTP.",
			"item": [
				{
					"name": "2.1 Realizar Depósito (POST /deposits)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 202 || pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    if (data.transactionId) {",
									"        pm.collectionVariables.set(\"lastTransactionId\", data.transactionId);",
									"        console.log(\"[Postman] lastTransactionId atualizado:\", data.transactionId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{$guid}}",
								"description": "UUID dinâmico de idempotência gerado a cada envio"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 150000,\n    \"description\": \"Depósito em dinheiro via Postman\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/transactions/deposits",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transactions",
								"deposits"
							]
						},
						"description": "Solicita um depósito em centavos (ex: 150000 = R$ 1.500,00). O valor deve ser um inteiro positivo longo. Retorna HTTP 202 Accepted imediatamente e dispara saga assíncrona para o ledger-service via Kafka."
					},
					"response": []
				},
				{
					"name": "2.2 Realizar Saque (POST /withdrawals)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 202 || pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    if (data.transactionId) {",
									"        pm.collectionVariables.set(\"lastTransactionId\", data.transactionId);",
									"        console.log(\"[Postman] lastTransactionId atualizado:\", data.transactionId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{$guid}}",
								"description": "UUID dinâmico de idempotência gerado a cada envio"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 35000,\n    \"description\": \"Saque no caixa eletrônico\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/transactions/withdrawals",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transactions",
								"withdrawals"
							]
						},
						"description": "Solicita um saque na conta do titular. Valida saldo suficiente no ledger core sob lock pessimista ordenado. Se não houver saldo, a transação é marcada como FAILED com rejectCode INSUFFICIENT_FUNDS."
					},
					"response": []
				},
				{
					"name": "2.3 Consultar Status da Transação",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/transactions/{{lastTransactionId}}",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transactions",
								"{{lastTransactionId}}"
							]
						},
						"description": "Consulta o status de resolução assíncrona da transação (PENDING, PROCESSING, COMPLETED ou FAILED)."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Core Contábil & Auditoria (ledger-service)",
			"description": "Endpoints internos do motor de partidas dobradas. Executados diretamente no ledger-service (porta 8084).",
			"item": [
				{
					"name": "3.1 Consultar Balancete Atômico (/trial-balance)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{ledgerServiceUrl}}/internal/v1/ledger/trial-balance",
							"host": [
								"{{ledgerServiceUrl}}"
							],
							"path": [
								"internal",
								"v1",
								"ledger",
								"trial-balance"
							]
						},
						"description": "Auditoria contábil matemática das partidas dobradas. Executa agregação condicional SQL atômica única no PostgreSQL, retornando debits, credits e difference. A invariante contábil estrita exige difference == 0."
					},
					"response": []
				},
				{
					"name": "3.2 Consultar Saldo Contábil da Conta (/balance)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{ledgerServiceUrl}}/internal/v1/ledger/accounts/{{accountId}}/balance",
							"host": [
								"{{ledgerServiceUrl}}"
							],
							"path": [
								"internal",
								"v1",
								"ledger",
								"accounts",
								"{{accountId}}",
								"balance"
							]
						},
						"description": "Consulta o saldo oficial auditável e o sequence number da conta dentro do plano de contas contábil."
					},
					"response": []
				},
				{
					"name": "3.3 Consultar Diário Contábil por Transação (/journals)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{ledgerServiceUrl}}/internal/v1/ledger/journals/by-transaction/{{lastTransactionId}}",
							"host": [
								"{{ledgerServiceUrl}}"
							],
							"path": [
								"internal",
								"v1",
								"ledger",
								"journals",
								"by-transaction",
								"{{lastTransactionId}}"
							]
						},
						"description": "Recupera os lançamentos contábeis de partidas dobradas (débito e crédito balanceados) vinculados a uma transação financeira."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Consultas CQRS & Extrato (query-service)",
			"description": "Endpoints de leitura otimizada para o aplicativo cliente e web dashboard (porta 8083 ou via Gateway).",
			"item": [
				{
					"name": "4.1 Consultar Saldo em Tempo Real",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/queries/accounts/{{accountId}}/balance",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"queries",
								"accounts",
								"{{accountId}}",
								"balance"
							]
						},
						"description": "Retorna saldo atualizado com número de sequência (asOfSequence)."
					},
					"response": []
				},
				{
					"name": "4.2 Consultar Extrato com Paginação por Cursor",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/queries/accounts/{{accountId}}/statement?size=20",
							"host": [
								"{{gatewayUrl}}"
							],
							"path": [
								"api",
								"v1",
								"queries",
								"accounts",
								"{{accountId}}",
								"statement"
							],
							"query": [
								{
									"key": "size",
									"value": "20"
								},
								{
									"key": "from",
									"value": "2026-01-01",
									"disabled": true
								},
								{
									"key": "to",
									"value": "2026-12-31",
									"disabled": true
								},
								{
									"key": "cursor",
									"value": "",
									"disabled": true
								}
							]
						},
						"description": "Retorna extrato bancário paginado com ordenação determinística por sequência contábil."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Health Checks & Actuator",
			"description": "Verificação de disponibilidade, conectividade com PostgreSQL/Kafka e métricas dos microsserviços.",
