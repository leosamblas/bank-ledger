							"raw": "{{transactionServiceUrl}}/actuator/health",
							"host": [
								"{{transactionServiceUrl}}"
							],
							"path": [
								"actuator",
								"health"
							]
						},
						"description": "Health check do transaction-service na porta 8082."
					},
					"response": []
				},
				{
					"name": "ledger-service Actuator Health",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{ledgerServiceUrl}}/actuator/health",
							"host": [
								"{{ledgerServiceUrl}}"
							],
							"path": [
								"actuator",
								"health"
							]
						},
						"description": "Health check do ledger-service na porta 8084."
					},
					"response": []
				},
				{
					"name": "query-service Actuator Health",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{queryServiceUrl}}/actuator/health",
							"host": [
								"{{queryServiceUrl}}"
							],
							"path": [
								"actuator",
								"health"
							]
						},
						"description": "Health check do query-service na porta 8083."
					},
					"response": []
